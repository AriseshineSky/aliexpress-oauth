<% content_for :title, "Everymarket · 授权中心" %>

<section class="space-y-10">
  <div>
    <p class="text-xs font-medium uppercase tracking-widest text-orange-600">Drop Shipping · OAuth</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Everymarket · 授权中心</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      AliExpress IOP 与 Mercado Livre（MLB / MLM / … 多站点）OAuth 回调集中管理。凭证与 Token 都存 Redis，按 App 隔离，互不覆盖。
    </p>
  </div>

  <% if flash[:notice].present? %>
    <p class="rounded-md bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert].present? %>
    <p class="rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-950"><%= flash[:alert] %></p>
  <% end %>

  <% unless @basic_auth_on %>
    <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">
      未设置 <code>BASIC_AUTH_USER</code> / <code>BASIC_AUTH_PASSWORD</code>，首页仍对公网开放。请立即在 Render 配置。
    </p>
  <% end %>

  <%= render "home/aliexpress" %>

  <hr class="border-slate-200">

  <%= render "home/mercadolivre" %>
</section>