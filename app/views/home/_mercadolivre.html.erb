<section class="space-y-6">
  <div>
    <p class="text-xs font-medium uppercase tracking-widest text-sky-600">Mercado Livre · MLB · 官方只读 API</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">Mercado Livre 授权</h2>
    <p class="mt-2 text-sm text-slate-600">
      多个 Client ID 共用同一 Redirect URI。Token 存 Redis，按 Client ID 隔离；读价格 / 库存走官方 API，不需要爬虫和代理。
    </p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500">App 凭证状态</p>
      <% if @ml_apps.any? %>
        <p class="mt-2 text-emerald-700">已配置 <%= @ml_apps.size %> 个 Client ID</p>
        <ul class="mt-2 space-y-1 text-sm text-slate-700">
          <% @ml_apps.each do |app| %>
            <li>
              <span class="font-mono"><%= app.app_key %></span>
              <span class="text-slate-500">
                （<%= app.display_name %><%= " · primary" if app.primary? %> · <%= app.redis? ? "Redis" : "环境变量" %>）
              </span>
            </li>
          <% end %>
        </ul>
        <p class="mt-1 text-xs text-slate-500">Client Secret 永不在页面展示</p>
      <% else %>
        <p class="mt-2 text-amber-800">尚未登记 App — 用下方表单写入 Redis</p>
      <% end %>
      <p class="mt-4 text-xs font-medium uppercase tracking-wide text-slate-500">Redis 状态</p>
      <% if @redis_ok %>
        <p class="mt-1 text-emerald-700">已连接</p>
      <% else %>
        <p class="mt-1 text-red-700">连接失败（检查 <code>REDIS_URL</code>）</p>
      <% end %>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500">开发中心配置指引（Mercado Livre DevCenter）</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-600">
        <li>创建应用：Nome / Nome curto / Logo 随意填</li>
        <li><strong>PKCE：关闭</strong>（保持 OFF）</li>
        <li>Escopos：<strong>Somente leitura</strong>（read-only）</li>
        <li>Tópicos / Notificações：可跳过</li>
      </ul>
      <p class="mt-3 text-sm text-slate-600">Redirect URI（仅填写，不要在浏览器打开，必须 HTTPS）：</p>
      <p class="mt-2 break-all font-mono text-sm text-slate-900 select-all"><%= @ml_callback_url %></p>
      <p class="mt-3 text-xs text-amber-800">
        授权请点下方蓝色「开始授权」。直接访问上面的地址不会带 code，无法完成授权。
      </p>
      <p class="mt-2 text-xs text-slate-500">
        凭证：<code>mercadolivre:oauth:apps</code> · Token：<code>mercadolivre:oauth:token:{app_key}</code>
      </p>
    </div>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-5">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">添加开发者 App</p>
    <p class="mt-2 text-sm text-slate-600">App ID 即开发中心的「App ID / Client ID」。写入 Redis，无需改 Render 环境变量。</p>
    <%= form_with url: ml_apps_path, method: :post, local: true, class: "mt-4 grid gap-3 sm:grid-cols-3" do %>
      <label class="block text-sm">
        <span class="text-slate-600">App ID (Client ID)</span>
        <input type="text" name="app_key" required autocomplete="off"
               class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm"
               placeholder="如 1234567890123456">
      </label>
      <label class="block text-sm">
        <span class="text-slate-600">Secret Key</span>
        <input type="password" name="app_secret" required autocomplete="new-password"
               class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm"
               placeholder="Client Secret">
      </label>
      <label class="block text-sm">
        <span class="text-slate-600">备注（可选）</span>
        <input type="text" name="label" autocomplete="off"
               class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
               placeholder="mlb-account-1">
      </label>
      <div class="sm:col-span-3">
        <button type="submit"
                class="inline-flex items-center rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-600"
                <%= "disabled" unless @redis_ok %>>
          保存到 Redis
        </button>
      </div>
    <% end %>
  </div>

  <% @ml_apps.each do |app| %>
    <% ml_token = @ml_tokens_by_app[app.app_key] %>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Token · <%= app.display_name %></p>
          <p class="mt-1 font-mono text-sm text-slate-900"><%= app.app_key %></p>
          <p class="mt-1 text-xs text-slate-500">
            Redis key <code>mercadolivre:oauth:token:<%= app.app_key %></code>
            · 凭证来源：<%= app.redis? ? "Redis" : "环境变量" %>
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <% if ml_token&.refresh_token.present? %>
            <%= button_to "刷新", ml_refresh_path(app_key: app.app_key), method: :post,
                class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 hover:bg-slate-50" %>
          <% end %>
          <%= link_to "开始授权", ml_authorize_path(app_key: app.app_key),
              class: "inline-flex items-center rounded-md bg-sky-600 px-3 py-2 text-sm font-medium text-white hover:bg-sky-500" %>
          <%= link_to "转发授权", ml_share_url_path(app_key: app.app_key),
              class: "inline-flex items-center rounded-md border border-sky-200 bg-white px-3 py-2 text-sm text-sky-700 hover:bg-sky-50",
              title: "生成本地网络被 CloudFront 封锁时可发给巴西/拉美网络的人 的授权链接（生产 HTTPS 回调）" %>
          <% if app.redis? %>
            <%= button_to "删除凭证", ml_app_path(app.app_key), method: :delete,
                form: { data: { turbo_confirm: "从 Redis 删除 App #{app.app_key}？Token 不会自动清除。" } },
                class: "inline-flex items-center rounded-md border border-red-200 bg-white px-3 py-2 text-sm text-red-700 hover:bg-red-50" %>
          <% end %>
        </div>
      </div>

      <% if ml_token&.usable? %>
        <p class="mt-3 text-emerald-700">有效</p>
        <p class="mt-1 text-sm text-slate-600">到期：<%= ml_token.expires_at || "—" %>（≈6h，可随时刷新）</p>
        <% if ml_token.account.present? %>
          <p class="mt-1 text-xs text-slate-500">Nickname: <%= ml_token.account %></p>
        <% end %>
        <% if ml_token.user_id.present? %>
          <p class="mt-1 text-xs text-slate-500">User ID: <%= ml_token.user_id %></p>
        <% end %>
        <p class="mt-3 font-mono text-xs text-slate-600">Access: <%= mask_secret(ml_token.access_token) %></p>
        <p class="mt-1 font-mono text-xs text-slate-600">Refresh: <%= mask_secret(ml_token.refresh_token) %></p>
      <% elsif ml_token %>
        <p class="mt-3 text-amber-800">已过期 — 可尝试强制刷新或重新授权</p>
        <p class="mt-1 font-mono text-xs text-slate-600">Access: <%= mask_secret(ml_token.access_token) %></p>
      <% else %>
        <p class="mt-3 text-slate-500">尚未授权</p>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
    授权必须从本页「开始授权」进入（会把 app_key 写入 state）。直接打开 Mercado Livre 授权页且不带 state 时，无法区分是哪个 App。
  </div>
</section>