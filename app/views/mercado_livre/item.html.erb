<% content_for :title, "Item #{@item_id}" %>

<section class="space-y-6">
  <div>
    <h1 class="text-2xl font-semibold">Item <%= @item_id %></h1>
    <p class="mt-1 text-sm text-slate-500">Mercado Livre 官方 API · 只读 · <%= @token ? "已带 Bearer Token" : "未带 Token（公开数据）" %></p>
  </div>

  <% if @error %>
    <p class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800"><%= @error %></p>
    <% if @details.present? %>
      <pre class="overflow-x-auto rounded-lg bg-slate-900 p-4 text-xs text-slate-100"><%= @details.is_a?(String) ? @details : (JSON.pretty_generate(@details) rescue @details.inspect) %></pre>
    <% end %>
  <% elsif @raw %>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <dl class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-slate-500">标题 Title</dt>
          <dd class="mt-1 text-slate-900"><%= @raw["title"] || "—" %></dd>
        </div>
        <div>
          <dt class="text-slate-500">价格 Price</dt>
          <dd class="mt-1 font-medium text-sky-700">
            <%= @raw["price"] %><%= @raw["currency_id"] %>
            <% if @raw["original_price"] && @raw["original_price"].to_f > @raw["price"].to_f %>
              <span class="text-slate-400 line-through"><%= @raw["original_price"] %> <%= @raw["currency_id"] %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-slate-500">库存 Available</dt>
          <dd class="mt-1"><%= @raw["available_quantity"] || "—" %></dd>
        </div>
        <div>
          <dt class="text-slate-500">已售 Sold</dt>
          <dd class="mt-1"><%= @raw["sold_quantity"] || "—" %></dd>
        </div>
        <div>
          <dt class="text-slate-500">卖家 Seller</dt>
          <dd class="mt-1"><%= @raw["seller_id"] || "—" %></dd>
        </div>
        <div>
          <dt class="text-slate-500">站点 / 状态</dt>
          <dd class="mt-1"><%= @raw["site_id"] || "—" %> · <%= @raw["status"] || "—" %></dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-slate-500">链接 Permalink</dt>
          <dd class="mt-1 break-all font-mono text-xs"><%= link_to(@raw["permalink"], @raw["permalink"], target: "_blank", class: "text-sky-700 hover:underline") if @raw["permalink"] %></dd>
        </div>
      </dl>
      <% if @raw["thumbnail"].present? %>
        <img src="<%= @raw["thumbnail"] %>" alt="thumb" class="mt-4 h-24 w-24 rounded-md border border-slate-200 object-cover">
      <% end %>
    </div>

    <details class="rounded-lg border border-slate-200 bg-white p-4">
      <summary class="cursor-pointer text-sm text-slate-600">Raw JSON</summary>
      <pre class="mt-3 overflow-x-auto text-xs"><%= JSON.pretty_generate(@raw) %></pre>
    </details>
  <% end %>

  <%= link_to "返回首页", root_path, class: "text-sm text-sky-700 hover:underline" %>
</section>